# ============================================================
# LifeLedger — Root Environment Reference
# ============================================================
# This file documents every environment variable used across the
# project. Actual runtime config lives in:
#   server/.env   (copy from server/.env.example)
#
# The client does not require a .env file — API calls are proxied
# to the backend via client/vite.config.js during development.

# ---- Server (server/.env) ----
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=lifeledger

JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

UPLOAD_DIR=uploads/documents
MAX_FILE_SIZE_MB=10
